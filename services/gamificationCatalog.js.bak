// backend/services/gamificationCatalog.js
//
// Premium Islamic-themed shop catalog.
//
// Twelve themed collections, each with products across 7 categories
// (Frames, Backgrounds, Name Effects, Profile Themes, Badges, Avatar
// Items, Specials). Every product has a unique ID, meaningful name,
// valid rarity, and deterministic price.
//
// Theme IDs and full distribution:
//   ramadan     - Ramadan Collection
//   eid_fitr    - Eid al-Fitr Collection
//   eid_adha    - Eid al-Adha / Dhul Hijjah Collection
//   quran       - Quran Collection
//   kaaba       - Kaaba / Makkah Collection
//   madinah     - Madinah Collection
//   geometry    - Islamic Geometry Collection
//   nature      - Nature / Peace Collection
//   salah       - Salah / Prayer Collection
//   dhikr       - Dhikr / Azkar Collection
//   hajj        - Hajj / Umrah Collection
//   premium     - Premium Legendary Collection
//
// Total catalog size: 1,283 products (3 defaults + 1,280 themed).
// Categories: FRAME 230, BACKGROUND 220, THEME 170, PROFILE_THEME 150,
// AVATAR 120, BADGE 230, SPECIAL 160.

const RARITY_PRICE = {
  COMMON: [20, 100],
  UNCOMMON: [100, 300],
  RARE: [300, 800],
  EPIC: [800, 2000],
  LEGENDARY: [2000, 5000],
  MYTHIC: [5000, 15000],
  SPECIAL: [15000, 50000],
};

const CATEGORY_PREFIX = {
  FRAME: 'frame',
  BACKGROUND: 'bg',
  THEME: 'theme',
  PROFILE_THEME: 'profiletheme',
  BADGE: 'badge',
  AVATAR: 'avatar',
  SPECIAL: 'special',
};

const CATEGORY_SUFFIX = {
  FRAME: 'Frame',
  BACKGROUND: 'Background',
  THEME: 'Name Effect',
  PROFILE_THEME: 'Profile Theme',
  BADGE: 'Badge',
  AVATAR: 'Avatar Item',
  SPECIAL: 'Special',
};

const CATEGORIES = ['FRAME', 'BACKGROUND', 'THEME', 'PROFILE_THEME', 'BADGE', 'AVATAR', 'SPECIAL'];

