// Sanity-check that every theme has at least max(per-category counts) items.
for (const [themeId, counts] of Object.entries(COLLECTION_COUNTS)) {
  const maxNeeded = Math.max(...Object.values(counts));
  const available = COLLECTIONS[themeId].items.length;
  if (available < maxNeeded) {
    throw new Error(`Theme ${themeId} needs at least ${maxNeeded} items, has ${available}`);
  }
}

// Sanity-check that each per-category sum across themes matches TARGET_COUNTS.
for (const category of CATEGORIES) {
  let total = 0;
  for (const counts of Object.values(COLLECTION_COUNTS)) {
    total += counts[category];
  }
  if (total !== TARGET_COUNTS[category]) {
    throw new Error(`Category ${category} sums to ${total}, expected ${TARGET_COUNTS[category]}`);
  }
}

const RARITY_AVAILABILITY_THRESHOLD = {
  COMMON: 95,
  UNCOMMON: 90,
  RARE: 80,
  EPIC: 60,
  LEGENDARY: 40,
  MYTHIC: 25,
  SPECIAL: 20,
};

// Build the full catalog by iterating each collection and emitting products
// for every (theme, category) up to the per-collection count. Item names
// cycle within the item list, which is fine because each theme has more
// unique items than its largest category count.
const buildItems = () => {
  const items = [...defaultItems];
  let globalIndex = 0;

  for (const [themeId, themeSpec] of Object.entries(COLLECTIONS)) {
    const counts = COLLECTION_COUNTS[themeId];
    const itemsList = themeSpec.items;

    for (const category of CATEGORIES) {
      const targetCount = counts[category];
      for (let i = 0; i < targetCount; i += 1) {
        // Pick the next item from the theme's pool. Since the pool is larger
        // than the largest per-category count, no item is reused within the
        // same (theme, category).
        const itemDef = itemsList[i];
        const item = {
          id: makeId(category, themeId, globalIndex),
          category,
          rarity: itemDef.rarity,
          price: computePrice(itemDef.rarity, globalIndex),
          available: computeAvailability(itemDef.rarity, globalIndex),
          limited: (globalIndex % 33) === 0,
          featured: (globalIndex % 17) === 0,
          isNew: globalIndex < 12,
          repeatable: false,
          // Theme metadata for frontend display.
          theme: themeId,
          collectionLabel: themeSpec.label,
          name: `${itemDef.name} ${CATEGORY_SUFFIX[category]}`,
          description: buildDescription(itemDef.name, category, themeSpec.label),
          icon: pickIcon(category),
        };
        items.push(item);
        globalIndex += 1;
      }
    }
  }

  return items;
};

const makeId = (category, themeId, index) => {
  const prefix = CATEGORY_PREFIX[category];
  const suffix = String(index + 1).padStart(4, '0');
  return `${prefix}_${themeId}_${suffix}`;
};

const computePrice = (rarity, index) => {
  const [minPrice, maxPrice] = RARITY_PRICE[rarity];
  // Spread prices inside the rarity band using a deterministic
  // hash of the index so identical rareness still varies in price.
  const factor = ((index * 31 + 17) % 100) / 100;
  return Math.round(minPrice + (maxPrice - minPrice) * factor);
};

const computeAvailability = (rarity, index) => {
  const threshold = RARITY_AVAILABILITY_THRESHOLD[rarity] || 90;
  return ((index * 13 + 7) % 100) < threshold;
};

const CATEGORY_ICON = {
  FRAME: 'images-outline',
  BACKGROUND: 'image-outline',
  THEME: 'sparkles-outline',
  PROFILE_THEME: 'color-palette-outline',
  BADGE: 'ribbon-outline',
  AVATAR: 'person-circle-outline',
  SPECIAL: 'diamond-outline',
};

const pickIcon = (category) => CATEGORY_ICON[category] || 'star-outline';

const buildDescription = (itemName, category, collectionLabel) => {
  const catLabel = CATEGORY_SUFFIX[category].toLowerCase();
  return `${itemName} — premium ${catLabel} from the ${collectionLabel}.`;
};

export const SHOP_CATALOG = buildItems();
export const SHOP_ITEMS_BY_ID = new Map(SHOP_CATALOG.map((item) => [item.id, item]));

export const getShopCatalog = () => SHOP_CATALOG;
export const getShopItem = (id) => SHOP_ITEMS_BY_ID.get(String(id)) || null;

export default { getShopCatalog, getShopItem, SHOP_CATALOG };